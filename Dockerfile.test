# Use Node 18 Alpine (much smaller base image ~50MB vs 300MB)
FROM node:18-alpine

# Install Chromium and dependencies (Alpine uses apk instead of apt)
RUN apk add --no-cache \
    chromium \
    nss \
    freetype \
    harfbuzz \
    ca-certificates \
    ttf-freefont \
    udev \
    xvfb

# Set Chromium path for Selenium
ENV CHROME_BIN=/usr/bin/chromium-browser \
    CHROME_PATH=/usr/lib/chromium/

# Set working directory
WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies including dev (chromedriver)
RUN npm ci --include=dev

# Copy test files
COPY tests/ ./tests/

# Set environment variables
ENV BASE_URL=http://localhost:3000

# Run tests
CMD ["npm", "test"]
